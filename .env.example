# Public Firebase web configuration. These values are safe for the browser but are
# environment specific, so they are supplied at build time and never committed.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to run the application against the local demo adapters.
# Demo mode keeps all data in this browser only and requires no Firebase project.
VITE_USE_DEMO_MODE=false
